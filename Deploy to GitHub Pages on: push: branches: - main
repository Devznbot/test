permissions:
  contents: write

# ...

      - name: Run linter (auto‑fix and push)
        env:
          GIT_AUTHOR_NAME: "github-actions[bot]"
          GIT_AUTHOR_EMAIL: "github-actions[bot]@users.noreply.github.com"
        run: |
          # attempt to auto-fix fixable issues
          deno lint --fix || true

          # if changes were made, commit and push them back
          git config user.name "$GIT_AUTHOR_NAME"
          git config user.email "$GIT_AUTHOR_EMAIL"
          git add -A
          if ! git diff --cached --quiet; then
            git commit -m "ci: apply deno lint --fix"
            git push
            echo "Auto-fixed lint issues and pushed changes."
          else
            echo "No auto-fix changes."
          fi

      - name: Run linter (verify)
        run: deno lint
